# Copy to .env (ignored), then replace REPLACE_ME with: openssl rand -hex 24
# For uv commands load this file explicitly with --env-file .env.
MEDEXA_ENVIRONMENT=development
MEDEXA_DB_HOST=127.0.0.1
MEDEXA_DB_PORT=5432
MEDEXA_DB_NAME=medexa_foundation_dev
MEDEXA_DB_USER=medexa_foundation
MEDEXA_DB_PASSWORD=REPLACE_ME
MEDEXA_LOG_LEVEL=INFO
MEDEXA_DEV_API_PORT=18081
# Optional Identity: blank secrets keep login disabled (503), never a fake login.
MEDEXA_TELEGRAM_BOT_TOKEN=
MEDEXA_CSRF_SIGNING_KEY=
MEDEXA_APP_ORIGIN=https://localhost

# Separate persistent cursor key, >=32 random bytes; blank disables content API.
MEDEXA_CONTENT_CURSOR_SIGNING_KEY=

# Enable only behind a configured, authenticated X-Accel-Redirect internal location.
MEDEXA_CONTENT_ASSET_DELIVERY_ENABLED=false
